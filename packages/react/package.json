{
  "name": "@arabdevkit/react",
  "version": "0.1.0",
  "description": "Accessible React primitives for Arab-market country, phone, and IBAN inputs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
